# Copy to deploy/deploy.env (git-ignored) and fill in for your own deployment.
DEPLOY_HOST=my-server            # an ssh host (e.g. from ~/.ssh/config)
DEPLOY_DIR=/opt/maiguard
VITE_API_BASE=https://api.example.com
VITE_WHATSAPP_NUMBER=""         # optional, quoted, e.g. "+234 800 000 0000"
FIREBASE_TARGET=maiguard         # hosting target from .firebaserc
