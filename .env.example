# AI provider. Set one of these; without either, MaiGuard runs on its rule-based fallback, so the demo always works.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Signs sessions. Set it in production so sign-ins survive restarts.
AUTH_SECRET=
# Coordinator desk email login: scrypt "salt:hash" of its password. Unset disables it.
# DESK_EMAIL=trustedvoice@local.com
DESK_PASSWORD_HASH=

# WhatsApp (Meta WhatsApp Business Platform). Webhook: /api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v25.0

# Web app origins allowed to call the API when it is hosted separately.
# CORS_ORIGINS=https://maiguard-app.web.app,https://maiguard-app.firebaseapp.com
# TOWN_TZ=Africa/Lagos
# PORT=8787
